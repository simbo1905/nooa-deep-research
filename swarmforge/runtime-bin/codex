#!/usr/bin/env bash
# SwarmForge roles run unattended in a mountless Lima guest. Codex's bundled
# Bubblewrap sandbox cannot configure guest loopback there, so use Codex's
# direct sandbox mode *inside the isolated VM*; this is not a host yolo mode.
# `codex exec` remains the non-interactive entrypoint.
set -euo pipefail

codex_bin="${CODEX_BIN:-$HOME/.bun/bin/codex}"
if [[ ! -x "$codex_bin" ]]; then
  echo "Codex executable not found at $codex_bin" >&2
  exit 127
fi

exec "$codex_bin" exec --sandbox danger-full-access "$@"
